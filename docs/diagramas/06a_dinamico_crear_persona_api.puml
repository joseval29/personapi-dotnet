@startuml 06a_dinamico_crear_persona_api
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/v2.10.0/C4_Dynamic.puml
LAYOUT_TOP_DOWN()
hide stereotype
title Diagrama Dinámico: crear una persona por la API REST (POST /api/personas)

Person(desarrollador, "Desarrollador / Cliente de la API", "Swagger, curl o Postman")
ContainerDb(db, "Base de datos persona_db", "SQL Server 2022 Express · contenedor personapi-sqlserver")

Boundary(webapp, "Aplicación Web Monolítica · contenedor personapi-web", "Contenedor") {
  Component(api, "PersonasApiController", "ControllerBase [ApiController]", "Recibe IPersonaRepository por inyección de dependencias")
  Component(dto, "PersonaDto + Mappers", "DataAnnotations", "Validación y conversión")
  Component(repo, "PersonaRepository", "Repositorio DAO", "Implementa IPersonaRepository")
  Component(ctx, "PersonaDbContext", "EF Core 7")
}

Rel(desarrollador, api, "POST /api/personas con el JSON de la persona", "HTTP/JSON · localhost:5080")
Rel(api, dto, "Valida el cuerpo; si es inválido responde 400 Bad Request")
Rel(api, repo, "ExistsAsync(cc) vía IPersonaRepository; si ya existe responde 409 Conflict")
Rel(api, dto, "ToEntity(): convierte PersonaDto en entidad Persona")
Rel(api, repo, "CreateAsync(persona) vía IPersonaRepository")
Rel(repo, ctx, "Personas.Add(persona) y SaveChangesAsync()")
Rel(ctx, db, "INSERT INTO persona ...", "SQL / TDS · sqlserver:1433")
Rel_Back(desarrollador, api, "Responde 201 Created con la persona y la cabecera Location", "HTTP/JSON")
skinparam LegendFontColor #333333
skinparam LegendBackgroundColor #FFFFFF
skinparam LegendBorderColor #BBBBBB
legend right
<b>Convenciones</b>
|<#08427B> <color:#FFFFFF> Persona </color> |
|<#85BBF0> <color:#000000> Componente </color> |
|<#438DD5> <color:#FFFFFF> Contenedor: base de datos </color> |
Los números indican el orden de los pasos
endlegend
@enduml
