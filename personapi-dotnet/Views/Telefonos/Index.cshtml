@model List<TelefonoDto>
@{
    ViewData["Title"] = "Teléfonos";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Teléfonos</h1>
    <a asp-action="Create" class="btn btn-success">+ Nuevo teléfono</a>
</div>
<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr><th>Número</th><th>Operador</th><th>Dueño</th><th class="text-end">Acciones</th></tr>
    </thead>
    <tbody>
    @if (Model.Count == 0)
    {
        <tr><td colspan="4" class="text-center text-muted">No hay teléfonos registrados</td></tr>
    }
    @foreach (var t in Model)
    {
        <tr>
            <td>@t.Num</td>
            <td>@t.Oper</td>
            <td>@t.Duenio - @t.NombreDuenio</td>
            <td class="text-end text-nowrap">
                <a asp-action="Details" asp-route-id="@t.Num" class="btn btn-sm btn-outline-secondary">Ver</a>
                <a asp-action="Edit" asp-route-id="@t.Num" class="btn btn-sm btn-outline-primary">Editar</a>
                <a asp-action="Delete" asp-route-id="@t.Num" class="btn btn-sm btn-outline-danger">Eliminar</a>
            </td>
        </tr>
    }
    </tbody>
</table>
