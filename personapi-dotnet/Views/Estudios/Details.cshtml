@model EstudioDto
@{
    ViewData["Title"] = "Detalle estudio";
}
<h1 class="h3">Detalle de estudio</h1>
<dl class="row">
    <dt class="col-sm-3">Persona</dt><dd class="col-sm-9">@Model.CcPer - @Model.NombrePersona</dd>
    <dt class="col-sm-3">Profesión</dt><dd class="col-sm-9">@Model.IdProf - @Model.NombreProfesion</dd>
    <dt class="col-sm-3">Fecha de grado</dt><dd class="col-sm-9">@(Model.Fecha?.ToString("yyyy-MM-dd") ?? "-")</dd>
    <dt class="col-sm-3">Universidad</dt><dd class="col-sm-9">@(Model.Univer ?? "-")</dd>
</dl>
<a asp-action="Edit" asp-route-idProf="@Model.IdProf" asp-route-ccPer="@Model.CcPer" class="btn btn-primary">Editar</a>
<a asp-action="Index" class="btn btn-secondary">Volver</a>
