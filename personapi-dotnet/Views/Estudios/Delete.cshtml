@model EstudioDto
@{
    ViewData["Title"] = "Eliminar estudio";
}
<h1 class="h3">Eliminar estudio</h1>
<div class="alert alert-warning">¿Seguro que desea eliminar este estudio?</div>
<dl class="row">
    <dt class="col-sm-3">Persona</dt><dd class="col-sm-9">@Model.CcPer - @Model.NombrePersona</dd>
    <dt class="col-sm-3">Profesión</dt><dd class="col-sm-9">@Model.IdProf - @Model.NombreProfesion</dd>
    <dt class="col-sm-3">Universidad</dt><dd class="col-sm-9">@(Model.Univer ?? "-")</dd>
</dl>
<form asp-action="Delete" method="post">
    <input type="hidden" name="idProf" value="@Model.IdProf" />
    <input type="hidden" name="ccPer" value="@Model.CcPer" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
