@model List<ProfesionDto>
@{
    ViewData["Title"] = "Profesiones";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Profesiones</h1>
    <a asp-action="Create" class="btn btn-success">+ Nueva profesión</a>
</div>
<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr><th>Id</th><th>Nombre</th><th>Descripción</th><th class="text-end">Acciones</th></tr>
    </thead>
    <tbody>
    @if (Model.Count == 0)
    {
        <tr><td colspan="4" class="text-center text-muted">No hay profesiones registradas</td></tr>
    }
    @foreach (var p in Model)
    {
        <tr>
            <td>@p.Id</td>
            <td>@p.Nom</td>
            <td class="small">@(string.IsNullOrWhiteSpace(p.Des) ? "-" : p.Des)</td>
            <td class="text-end text-nowrap">
                <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary">Ver</a>
                <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                <a asp-action="Delete" asp-route-id="@p.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
            </td>
        </tr>
    }
    </tbody>
</table>
